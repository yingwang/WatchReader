<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading aloud: a foreground media service, and its notification (asked for at run time on
         Android 13 and later; listening works without it, only the notification is missing). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Speech engines are discovered through this intent. Since Android 11 a package is only
         visible when queried for, so without this the phone may report no engine at all. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Look up and Translate in the reader hand selected words to apps already on the phone (a
         dictionary, Google Translate). From Android 11 an app sees only the apps it names here,
         so without these the reader would find none of them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".WatchReaderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchReader">

        <activity
            android:name=".ui.MobileActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WatchReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to WatchReader" from file managers, browsers and mail clients. A browser
                 shares a link as text/plain, and that link goes to the add screen's link field.
                 A zipped .fb2 is shared as a plain ZIP. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- "Open with WatchReader" for downloaded .txt / .epub / .fb2 files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/watchreader_wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/reading-progress/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/reading-time/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/reader-bookmarks/v1/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/book_received" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/book_removed" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/progress" />
            </intent-filter>
        </service>

        <!-- Reads a book aloud with the screen off and the reader closed. -->
        <service
            android:name=".service.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
